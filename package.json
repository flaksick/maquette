{
  "name": "maquette",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Offline iPad sculpting web app. Everything runs on the device.",
  "scripts": {
    "icons": "node scripts/gen-icons.mjs",
    "core": "sh scripts/build-core.sh",
    "probe:dev": "vite --config vite.probe.config.ts --host",
    "probe:build": "npm run icons && npm run core && vite build --config vite.probe.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "spec": "node scripts/gen-spec.mjs",
    "verify": "node scripts/verify.mjs",
    "status": "node scripts/feature-status.mjs",
    "check-ui": "node scripts/check-ui.mjs",
    "deploy:dev": "node scripts/deploy.mjs dev",
    "app:dev": "vite --config vite.app.config.ts --mode dev --host",
    "app:build": "npm run icons && npm run core && vite build --config vite.app.config.ts --mode dev && vite build --config vite.app.config.ts --mode prod"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "yaml": "^2.9.1"
  },
  "dependencies": {
    "@preact/signals": "^2.11.3",
    "preact": "^11.0.1"
  }
}
