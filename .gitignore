# Allow-list: ignore everything, then permit known source types (invariant 11).
*
!*/

!*.rs
!*.toml
!*.lock
!*.ts
!*.tsx
!*.js
!*.mjs
!*.cjs
!*.json
!*.html
!*.css
!*.md
!*.yaml
!*.yml
!*.wat
!*.glsl
!*.py
!*.sh
!*.svg
!*.webmanifest
!.gitignore
!.gitleaks.toml
!scripts/hooks/*

# ---- hard denies (listed last so they win) ----
node_modules/
target/
dist/
deploy/
deploy-e2e/
.cache/
test-results/
playwright-report/
*.wasm
.env
.env.*
*.pem
*.key
*.p12
*token*
*secret*
*credential*
.mcp.json
.DS_Store
