#!/bin/sh
# Invariant 11: nothing secret reaches the public repo. Scan what is being committed.
if ! command -v gitleaks >/dev/null 2>&1; then
  echo "pre-commit: gitleaks not installed (brew install gitleaks); refusing to commit." >&2
  exit 1
fi
gitleaks git --pre-commit --staged --redact --no-banner -l warn || {
  echo "pre-commit: gitleaks found a possible secret in staged changes. Commit blocked." >&2
  exit 1
}
